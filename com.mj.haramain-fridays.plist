    <key>WorkingDirectory</key>
    <string>/Users/mj/tensor-sagan</string>

    <!--
        Auto-tick the state machine hourly across the Friday/Saturday window.
        Fires on the hour, every hour, on Fridays (06:00–23:00) and Saturday
        mornings (00:00–12:00). Each tick is idempotent — once status=sent,
        further ticks are cheap noops until next Friday.

        Times are interpreted in the system's local time zone.
    -->
    <key>StartCalendarInterval</key>
    <array>
        <!-- Friday: hours 6 through 23 -->
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
