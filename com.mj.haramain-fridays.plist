    <!--
        Hourly tick across the Friday→Sunday window.

        Previously this stopped at Saturday 12:00. On 2026-10-03 a draft was
        created at 12:07 — seven minutes after the final tick of the week — and
        its review email failed to send during a network outage. With no later
        tick, nothing could re-send the reminder, and the draft would have been
        orphaned once target_friday rolled over to the next Friday. The window
        now runs to Sunday evening so a late or failed draft still has retries.

        Ticks are idempotent: once status=sent they are cheap noops.
        Times are interpreted in the system's local time zone.
        launchd weekday: 0=Sunday, 5=Friday, 6=Saturday.
    -->
    <key>StartCalendarInterval</key>
    <array>
        <!-- Friday 06:00-23:00 -->
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
