# Friday Sermon Email Configuration
# Copy this file to .env and fill in your credentials

# Gemini API Key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — override the Gemini model (defaults to gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# SMTP — the account subscribers receive mail FROM.
# For Gmail this must be an App Password, not the account password:
#   https://myaccount.google.com/apppasswords
# App Passwords only become available once 2-Step Verification is enabled
# on that account.
SMTP_EMAIL=haramainfridays@gmail.com
SMTP_PASSWORD=your_16_char_app_password_here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Display name subscribers see on the From line
SENDER_NAME=Haramain Fridays

# Where draft-approval emails and health alerts go — your own inbox, not
# the subscriber list. Defaults to mjeelani@gmail.com if unset.
REVIEWER_EMAIL=mjeelani@gmail.com

# Legacy — not used by --auto; subscribers come from Firestore
RECIPIENT_EMAIL=mjeelani@gmail.com
