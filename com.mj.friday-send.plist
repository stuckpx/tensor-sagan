<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mj.friday-send</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/mj/.gemini/antigravity/playground/tensor-sagan/friday_sermon_email.py</string>
        <string>--send</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/Users/mj/.gemini/antigravity/playground/tensor-sagan</string>
    
    <!-- Run every Friday at 6:00 PM PST -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>  <!-- Friday = 5 -->
        <key>Hour</key>
        <integer>18</integer>  <!-- 6 PM local time -->
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    
    <key>StandardOutPath</key>
    <string>/Users/mj/Library/Logs/friday-sermon-send.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/mj/Library/Logs/friday-sermon-send.log</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
